<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

	<!-- Job: {{txtServiceName}} 빈의 {{xml txtServiceMethod}}() 호출 -->
	<bean id="{{txtJobName}}" class="org.springframework.scheduling.quartz.MethodInvokingJobDetailFactoryBean">
		<property name="targetObject" ref="{{txtServiceName}}"/>
		<property name="targetMethod" value="{{xml txtServiceMethod}}"/>
		<property name="concurrent" value="{{cboConcurrent}}"/>
	</bean>

</beans>
