<?xml version="1.0" encoding="UTF-8"?>
<!--
    전자정부 표준프레임워크 표준 Inspection 룰셋(44개 규칙)을 PMD 7 기본 규칙으로 가리킨다. Ferrite가 만든다.
    - 규칙과 메시지: 공식 문서(eGovFramework/egovframe-docs의 코드 점검 문서) 표의 규칙과 설명
    - 우선순위: 공식 룰셋(개발환경 4.3)과 같다
    - 공식 4.3 룰셋은 XPath 규칙 5개(EmptyCatchBlock 등)가 PMD 7 정식판에서 이름이 바뀐 노드를 써서
      아무것도 잡지 못한다. 여기서는 PMD가 관리하는 같은 이름의 규칙을 가리킨다.
    - 규칙의 세부 설정은 PMD 기본값을 쓴다.
-->
<ruleset name="egov-inspection-rules"
    xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">
    <description>전자정부 표준프레임워크 표준 Inspection 룰셋(PMD 7)</description>
    <!-- 1. AbstractClassWithoutAbstractMethod -->
    <rule ref="category/java/bestpractices.xml/AbstractClassWithoutAbstractMethod" message="Abstract Class내에 Abstract Method가 존재하지 않음">
        <priority>3</priority>
    </rule>
    <!-- 2. ArrayIsStoredDirectly · SW 보안약점: Public 메소드부터 반환된 Private 배열 -->
    <rule ref="category/java/bestpractices.xml/ArrayIsStoredDirectly" message="배열객체 참조 외부 노출">
        <priority>3</priority>
    </rule>
    <!-- 3. AssignmentInOperand -->
    <rule ref="category/java/errorprone.xml/AssignmentInOperand" message="피연산자내에 할당문이 사용됨. 해당 코드를 복잡하고 가독성이 떨어지게 만듦">
        <priority>3</priority>
    </rule>
    <!-- 4. AssignmentToNonFinalStatic -->
    <rule ref="category/java/errorprone.xml/AssignmentToNonFinalStatic" message="static 필드의 안전하지않은 사용 가능성이 존재">
        <priority>3</priority>
    </rule>
    <!-- 5. AvoidArrayLoops -->
    <rule ref="category/java/performance.xml/AvoidArrayLoops" message="배열의 값을 루프문을 이용하여 복사하는 것 보다, System.arraycopy() 메소드를 이용하여 복사하는 것이 효율적이며 수행 속도가 빠름">
        <priority>3</priority>
    </rule>
    <!-- 6. AvoidCatchingGenericException · SW 보안약점: 부적절한 예외처리 -->
    <rule ref="category/java/design.xml/AvoidCatchingGenericException" message="부적절한 예외처리">
        <priority>3</priority>
    </rule>
    <!-- 7. AvoidPrintStackTrace · SW 보안약점: 오류 메시지를 통한 정보 노출 -->
    <rule ref="category/java/bestpractices.xml/AvoidPrintStackTrace" message="오류 메시지를 통한 정보 노출 (시스템 데이터 정보 노출)">
        <priority>3</priority>
    </rule>
    <!-- 8. AvoidReassigningParameters -->
    <rule ref="category/java/bestpractices.xml/AvoidReassigningParameters" message="넘겨받는 메소드 parameter 값을 직접 변경하는 코드 탐지">
        <priority>2</priority>
    </rule>
    <!-- 9. AvoidSynchronizedAtMethodLevel -->
    <rule ref="category/java/multithreading.xml/AvoidSynchronizedAtMethodLevel" message="mothod 레벨의 synchronization 보다 block 레벨 synchronization 을 사용하는 것이 바람직함">
        <priority>3</priority>
    </rule>
    <!-- 10. AvoidThrowingNullPointerException -->
    <rule ref="category/java/design.xml/AvoidThrowingNullPointerException" message="NullPointerException을 throw하는 것은 비추천">
        <priority>1</priority>
    </rule>
    <!-- 11. AvoidThrowingRawExceptionTypes -->
    <rule ref="category/java/design.xml/AvoidThrowingRawExceptionTypes" message="가공되지 않은 Exception을 throw하는 것은 비추천">
        <priority>1</priority>
    </rule>
    <!-- 12. AvoidUsingHardCodedIP · SW 보안약점: 하드코드된 중요정보 -->
    <rule ref="category/java/bestpractices.xml/AvoidUsingHardCodedIP" message="하드코드된 IP 사용">
        <priority>3</priority>
    </rule>
    <!-- 13. BrokenNullCheck · SW 보안약점: 널(Null) 포인터 역참조 -->
    <rule ref="category/java/errorprone.xml/BrokenNullCheck" message="잘못된 널(Null) 체크">
        <priority>2</priority>
    </rule>
    <!-- 14. CloseResource · SW 보안약점: 부적절한 자원 해제 -->
    <rule ref="category/java/errorprone.xml/CloseResource" message="부적절한 자원 해제">
        <priority>3</priority>
    </rule>
    <!-- 15. ConstantsInInterface -->
    <rule ref="category/java/bestpractices.xml/ConstantsInInterface" message="인터페이스에 상수 적용">
        <priority>3</priority>
    </rule>
    <!-- 16. EmptyCatchBlock · SW 보안약점: 빈 Catch 문 사용, 오류 상황 대응 부재 -->
    <rule ref="category/java/errorprone.xml/EmptyCatchBlock" message="내용이 없는 Catch Block이 존재, 오류 상황 대응 부재">
        <priority>3</priority>
    </rule>
    <!-- 17. EmptyControlStatement -->
    <rule ref="category/java/codestyle.xml/EmptyControlStatement" message="빈 finally 블록 사용, 빈 if 문 사용, 빈 try 블록 사용, 빈 while문 사용">
        <priority>3</priority>
    </rule>
    <!-- 18. EqualsNull -->
    <rule ref="category/java/errorprone.xml/EqualsNull" message="null 값과 비교하기 위해 equals 메소드를 사용하였음">
        <priority>1</priority>
    </rule>
    <!-- 19. FieldNamingConventions -->
    <rule ref="category/java/codestyle.xml/FieldNamingConventions" message="변수명에 밑줄 사용">
        <priority>1</priority>
    </rule>
    <!-- 20. FinalFieldCouldBeStatic -->
    <rule ref="category/java/design.xml/FinalFieldCouldBeStatic" message="final field를 static으로 변경하면 overhead를 줄일 수 있음">
        <priority>3</priority>
    </rule>
    <!-- 21. FormalParameterNamingConventions -->
    <rule ref="category/java/codestyle.xml/FormalParameterNamingConventions" message="변수명에 밑줄 사용">
        <priority>1</priority>
    </rule>
    <!-- 22. HardCodedCryptoKey · SW 보안약점: 하드코드된 중요정보 -->
    <rule ref="category/java/security.xml/HardCodedCryptoKey" message="하드코드된 암호화키 사용">
        <priority>3</priority>
    </rule>
    <!-- 23. ImmutableField -->
    <rule ref="category/java/design.xml/ImmutableField" message="생성자를 통해 할당된 변수를 Final로 선언하지 않았음">
        <priority>3</priority>
    </rule>
    <!-- 24. InefficientEmptyStringCheck -->
    <rule ref="category/java/performance.xml/InefficientEmptyStringCheck" message="빈 문자열 확인을 위해 String.trim().length() 을 사용하는 것은 피하도록 함. whitespace/Non-whitespace 확인을 위한 별도의 로직 구현을 권장">
        <priority>3</priority>
    </rule>
    <!-- 25. InefficientStringBuffering -->
    <rule ref="category/java/performance.xml/InefficientStringBuffering" message="StringBuffer 함수내에서 비문자열 연산 이용하여 직접 결합하는 코드 사용을 탐지. append 메소드 사용을 권장">
        <priority>3</priority>
    </rule>
    <!-- 26. LocalVariableNamingConventions -->
    <rule ref="category/java/codestyle.xml/LocalVariableNamingConventions" message="final이 아닌 변수는 밑줄을 포함할 수 없음">
        <priority>1</priority>
    </rule>
    <!-- 27. MethodReturnsInternalArray · SW 보안약점: Private 배열에 Public 데이터 할당 -->
    <rule ref="category/java/bestpractices.xml/MethodReturnsInternalArray" message="클래스내 내부배열을 직접 반환하는 메소드">
        <priority>3</priority>
    </rule>
    <!-- 28. MisplacedNullCheck · SW 보안약점: 널(Null) 포인터 역참조 -->
    <rule ref="category/java/errorprone.xml/MisplacedNullCheck" message="널(Null) 체크의 잘못된 위치">
        <priority>3</priority>
    </rule>
    <!-- 29. SimpleDateFormatNeedsLocale -->
    <rule ref="category/java/errorprone.xml/SimpleDateFormatNeedsLocale" message="SimpleDateFormat 인스턴스를 생성할 때 Locale 을 지정하는 것이 바람직함">
        <priority>3</priority>
    </rule>
    <!-- 30. SimplifyBooleanExpressions -->
    <rule ref="category/java/design.xml/SimplifyBooleanExpressions" message="boolean 사용 시 불필요한 비교 연산을 피하도록 함">
        <priority>3</priority>
    </rule>
    <!-- 31. StringInstantiation -->
    <rule ref="category/java/performance.xml/StringInstantiation" message="불필요한 String Instance를 생성하는 코드를 탐지. 간단한 형태의 코드로 변경 필요">
        <priority>2</priority>
    </rule>
    <!-- 32. StringToString -->
    <rule ref="category/java/performance.xml/StringToString" message="String 객체에서 toString()함수를 사용하는 것은 불필요함. 해당 코드 제거 필요">
        <priority>3</priority>
    </rule>
    <!-- 33. SwitchStmtsShouldHaveDefault -->
    <!-- PMD 7에서 이름이 NonExhaustiveSwitch(으)로 바뀌었다. -->
    <rule ref="category/java/bestpractices.xml/NonExhaustiveSwitch" message="Switch구문에는 반드시 default label이 있어야 함">
        <priority>3</priority>
    </rule>
    <!-- 34. SystemPrintln -->
    <rule ref="category/java/bestpractices.xml/SystemPrintln" message="System.out.print 가 사용됨. 전용 로거를 사용할 것을 권장">
        <priority>2</priority>
    </rule>
    <!-- 35. UncommentedEmptyMethodBody -->
    <rule ref="category/java/documentation.xml/UncommentedEmptyMethodBody" message="빈 메소드에 빈메소드임을 나타내는 주석을 추가할 것">
        <priority>3</priority>
    </rule>
    <!-- 36. UnnecessaryBoxing -->
    <rule ref="category/java/codestyle.xml/UnnecessaryBoxing" message="불필요한 WrapperObject 생성">
        <priority>3</priority>
    </rule>
    <!-- 37. UnnecessaryConversionTemporary -->
    <rule ref="category/java/errorprone.xml/UnnecessaryConversionTemporary" message="기본 데이터 타입을 String으로 변환할 때 불필요한 임시 변환 작업을 피하도록 함">
        <priority>3</priority>
    </rule>
    <!-- 38. UnnecessaryImport -->
    <rule ref="category/java/codestyle.xml/UnnecessaryImport" message="불필요한 import문 선언">
        <priority>4</priority>
    </rule>
    <!-- 39. UnnecessarySemicolon -->
    <rule ref="category/java/codestyle.xml/UnnecessarySemicolon" message="필요없는 ; 문장 존재">
        <priority>3</priority>
    </rule>
    <!-- 40. UnusedFormalParameter -->
    <rule ref="category/java/bestpractices.xml/UnusedFormalParameter" message="메소드 선언 내에사용되지 않는 파라미터를 탐지">
        <priority>3</priority>
    </rule>
    <!-- 41. UnusedPrivateField -->
    <rule ref="category/java/bestpractices.xml/UnusedPrivateField" message="사용되지 않는 Private field의 탐지">
        <priority>3</priority>
    </rule>
    <!-- 42. UnusedPrivateMethod -->
    <rule ref="category/java/bestpractices.xml/UnusedPrivateMethod" message="사용되지 않는 Private Method 선언을 탐지">
        <priority>3</priority>
    </rule>
    <!-- 43. UselessParentheses -->
    <rule ref="category/java/codestyle.xml/UselessParentheses" message="불필요한 괄호사용">
        <priority>4</priority>
    </rule>
    <!-- 44. UselessStringValueOf -->
    <rule ref="category/java/performance.xml/UselessStringValueOf" message="String 을 append 할 경우, String.valueOf 함수를 사용할 필요 없음">
        <priority>3</priority>
    </rule>
</ruleset>
