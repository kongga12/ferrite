package {{txtConfigPackage}};

{{#if (eq rdoType "Internal Properties")}}
import java.util.HashMap;
import java.util.Map;
{{/if}}
{{#if (eq rdoType "External File")}}
import java.util.HashMap;
import java.util.HashSet;
import java.util.Map;
import java.util.Set;
{{/if}}

import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;

import {{rte}}.fdl.property.impl.EgovPropertyServiceImpl;

/**
 * 프로퍼티 서비스(EgovPropertyService).
 */
@Configuration
public class {{txtFileName}} {

	// 이 서비스는 messageSource 빈이 있어야 한다(basenames에 classpath:/{{rtePath}}/fdl/property/messages/properties 포함).
	// egov 프로젝트는 보통 context-common.xml·EgovConfigAppCommon에 둔다.
	@Bean(name = "{{txtPropertyServiceName}}", destroyMethod = "destroy")
	public EgovPropertyServiceImpl propertyService() {
		EgovPropertyServiceImpl service = new EgovPropertyServiceImpl();
{{#if (eq rdoType "Internal Properties")}}
		Map<String, String> properties = new HashMap<String, String>();
		properties.put("{{java txtKey}}", "{{java txtValue}}");
		service.setProperties(properties);
{{/if}}
{{#if (eq rdoType "External File")}}
		Map<String, String> file = new HashMap<String, String>();
		file.put("encoding", "{{java cboEncoding}}");
		file.put("filename", "{{java txtPropertyFile}}");
		Set<Object> files = new HashSet<Object>();
		files.add(file);
		service.setExtFileName(files);
{{/if}}
		return service;
	}
}
