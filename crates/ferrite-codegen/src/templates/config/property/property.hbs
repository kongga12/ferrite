<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

	<!-- 프로퍼티 서비스(EgovPropertyService) -->
	<!-- 이 서비스는 messageSource 빈이 있어야 한다(basenames에 classpath:/{{rtePath}}/fdl/property/messages/properties 포함).
	     egov 프로젝트는 보통 context-common.xml에 둔다. -->
	<bean name="{{txtPropertyServiceName}}" class="{{rte}}.fdl.property.impl.EgovPropertyServiceImpl" destroy-method="destroy">
{{#if (eq rdoType "Internal Properties")}}
		<property name="properties">
			<map>
				<entry key="{{xml txtKey}}" value="{{xml txtValue}}"/>
			</map>
		</property>
{{/if}}
{{#if (eq rdoType "External File")}}
		<property name="extFileName">
			<set>
				<map>
					<entry key="encoding" value="{{cboEncoding}}"/>
					<entry key="filename" value="{{xml txtPropertyFile}}"/>
				</map>
			</set>
		</property>
{{/if}}
	</bean>

</beans>
