# log4j2 설정
Configuration:
  status: warn
  Appenders:
    RollingFile:
      name: {{yaml txtAppenderName}}
      fileName: {{yaml txtLogFileName}}
      filePattern: {{yaml txtLogFileNamePattern}}
      PatternLayout:
        pattern: {{yaml txtConversionPattern}}
      Policies:
        TimeBasedTriggeringPolicy:
          interval: {{txtInterval}}
          modulate: {{cboModulate}}

  Loggers:
    Logger:
      - name: egovframework
        level: debug
        additivity: false
        AppenderRef:
          ref: {{yaml txtAppenderName}}
      - name: org.egovframe
        level: debug
        additivity: false
        AppenderRef:
          ref: {{yaml txtAppenderName}}
      - name: org.springframework
        level: info
        additivity: false
        AppenderRef:
          ref: {{yaml txtAppenderName}}
    Root:
      level: info
      AppenderRef:
        ref: {{yaml txtAppenderName}}
