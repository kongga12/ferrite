{
  "name": "HTTP 요청",
  "scopeName": "source.http",
  "patterns": [
    { "include": "#separator" },
    { "include": "#comment" },
    { "include": "#file-variable" },
    { "include": "#pre-script" },
    { "include": "#request" }
  ],
  "repository": {
    "separator": { "match": "^\\s*###.*", "name": "markup.heading.http" },
    "comment": {
      "begin": "^\\s*(?:#|//)",
      "end": "$",
      "name": "comment.line.http",
      "patterns": [
        {
          "match": "@(?:name|insecure|no-redirect|no-cookie-jar)\\b",
          "name": "keyword.other.directive.http"
        }
      ]
    },
    "file-variable": {
      "begin": "^\\s*(@[\\w.-]+)\\s*(=)",
      "beginCaptures": { "1": { "name": "variable.other.property.http" } },
      "end": "$",
      "contentName": "string.unquoted.http",
      "patterns": [{ "include": "#variable" }]
    },
    "variable": { "match": "\\{\\{[^}]*\\}\\}", "name": "entity.name.tag.variable.http" },
    "request": {
      "comment": "메서드가 없는 줄도 요청 줄이다(GET). 끝은 다음 ###.",
      "begin": "^\\s*(?=\\S)(?:((?i:GET|POST|PUT|DELETE|PATCH|HEAD|OPTIONS|TRACE|CONNECT))(?:\\s+|$))?",
      "beginCaptures": { "1": { "name": "keyword.control.http" } },
      "end": "\\A(?=\\s*###)",
      "patterns": [{ "include": "#request-line" }, { "include": "#headers" }]
    },
    "request-line": {
      "comment": "요청 줄의 나머지(주소). 첫 줄에서만 맞도록 닻(\\G)에서 시작한다.",
      "begin": "\\G(?=\\S)",
      "end": "$",
      "contentName": "string.unquoted.url.http",
      "patterns": [
        { "include": "#variable" },
        { "match": "\\s+(HTTP/[\\d.]+)\\s*$", "captures": { "1": { "name": "constant.other.version.http" } } }
      ]
    },
    "headers": {
      "patterns": [
        { "include": "#body" },
        { "include": "#save" },
        { "include": "#handler" },
        { "include": "#comment" },
        {
          "begin": "^\\s*(?=[?&])",
          "end": "$",
          "contentName": "string.unquoted.url.http",
          "patterns": [{ "include": "#variable" }]
        },
        {
          "begin": "^\\s*([^\\s:]+)\\s*(:)",
          "beginCaptures": { "1": { "name": "entity.other.attribute-name.header.http" } },
          "end": "$",
          "patterns": [{ "include": "#variable" }]
        }
      ]
    },
    "body": {
      "comment": "헤더 뒤의 첫 빈 줄부터 다음 ###까지. 줄 끝의 줄바꿈 뒤에서도 ^가 맞으므로 줄 처음(\\A)으로 잡는다.",
      "begin": "\\A\\s*$",
      "end": "\\A(?=\\s*###)",
      "patterns": [
        { "include": "#save" },
        { "include": "#handler" },
        { "include": "#file-include" },
        { "include": "#variable" },
        { "include": "#json" }
      ]
    },
    "save": {
      "match": "^\\s*(>>!?)\\s*(.*)",
      "captures": {
        "1": { "name": "keyword.other.save.http" },
        "2": { "name": "string.unquoted.path.http" }
      }
    },
    "handler": {
      "comment": "응답 처리 스크립트(JS)와 스크립트 파일.",
      "patterns": [
        {
          "begin": "^\\s*(>)\\s*(\\{%)",
          "beginCaptures": {
            "1": { "name": "keyword.other.handler.http" },
            "2": { "name": "keyword.other.handler.http" }
          },
          "end": "%\\}",
          "endCaptures": { "0": { "name": "keyword.other.handler.http" } },
          "contentName": "meta.embedded.block.js",
          "patterns": [{ "include": "#js" }]
        },
        {
          "match": "^\\s*(>)\\s+(.*)",
          "captures": {
            "1": { "name": "keyword.other.handler.http" },
            "2": { "name": "string.unquoted.path.http" }
          }
        }
      ]
    },
    "pre-script": {
      "comment": "요청 줄 앞의 요청 전 스크립트(JS)와 스크립트 파일. 요청 줄로 보지 않게 먼저 잡는다.",
      "patterns": [
        {
          "begin": "^\\s*(<)\\s*(\\{%)",
          "beginCaptures": {
            "1": { "name": "keyword.other.handler.http" },
            "2": { "name": "keyword.other.handler.http" }
          },
          "end": "%\\}",
          "endCaptures": { "0": { "name": "keyword.other.handler.http" } },
          "contentName": "meta.embedded.block.js",
          "patterns": [{ "include": "#js" }]
        },
        {
          "match": "^\\s*(<)\\s+(.*)",
          "captures": {
            "1": { "name": "keyword.other.handler.http" },
            "2": { "name": "string.unquoted.path.http" }
          }
        }
      ]
    },
    "js": {
      "comment": "응답 스크립트에서 흔히 쓰는 것만 칠한다.",
      "patterns": [
        { "match": "//.*?(?=%\\}|$)", "name": "comment.line.double-slash.js" },
        { "begin": "/\\*", "end": "\\*/", "name": "comment.block.js" },
        {
          "begin": "\"",
          "end": "\"|$",
          "name": "string.quoted.double.js",
          "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.js" }]
        },
        {
          "begin": "'",
          "end": "'|$",
          "name": "string.quoted.single.js",
          "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.js" }]
        },
        {
          "begin": "`",
          "end": "`",
          "name": "string.template.js",
          "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.js" }]
        },
        { "match": "\\b\\d+(?:\\.\\d+)?\\b", "name": "constant.numeric.js" },
        { "match": "\\b(?:true|false|null|undefined)\\b", "name": "constant.language.js" },
        {
          "match": "\\b(?:var|let|const|function|return|if|else|for|while|do|break|continue|try|catch|finally|throw|new|typeof|instanceof|of|in|switch|case|default)\\b",
          "name": "keyword.control.js"
        },
        { "match": "\\b(?:client|request|response|crypto|console)\\b", "name": "variable.language.js" },
        { "match": "\\b[A-Za-z_$][\\w$]*(?=\\s*\\()", "name": "entity.name.function.js" }
      ]
    },
    "file-include": {
      "match": "^\\s*(<)\\s+(.*)",
      "captures": {
        "1": { "name": "keyword.other.include.http" },
        "2": { "name": "string.unquoted.path.http" }
      }
    },
    "json": {
      "patterns": [
        { "match": "\"(?:[^\"\\\\]|\\\\.)*\"(?=\\s*:)", "name": "variable.other.property.key.http" },
        {
          "begin": "\"",
          "end": "\"|$",
          "name": "string.quoted.double.http",
          "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.http" }, { "include": "#variable" }]
        },
        { "match": "-?\\b\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?\\b", "name": "constant.numeric.http" },
        { "match": "\\b(?:true|false|null)\\b", "name": "constant.language.http" }
      ]
    }
  }
}
