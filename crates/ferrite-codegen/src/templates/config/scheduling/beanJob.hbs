<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

	<!-- Job: QuartzJobBean을 상속한 {{xml txtServiceClass}} -->
	<bean id="{{txtJobName}}" class="org.springframework.scheduling.quartz.JobDetailFactoryBean">
		<property name="jobClass" value="{{xml txtServiceClass}}"/>
		<property name="durability" value="true"/>
{{#if chkProperty}}
		<property name="jobDataAsMap">
			<map>
				<entry key="{{xml txtPropertyName}}" value="{{xml txtPropertyValue}}"/>
			</map>
		</property>
{{/if}}
	</bean>

</beans>
